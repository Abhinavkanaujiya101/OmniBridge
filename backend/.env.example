PORT=5000
WS_PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Provider Keys
# Gemini: TEXT, MATH, CODE (primary cheapest route)
GEMINI_API_KEY=your_gemini_api_key
# OpenAI: TEXT, MATH, CODE (fallback)
OPENAI_API_KEY=your_openai_api_key
# Together AI: TEXT (Llama/Mixtral) + IMAGE_GENERATION (FLUX.1-schnell, FLUX.1.1-pro, SDXL)
TOGETHER_API_KEY=your_together_api_key
# Luma AI API: VIDEO_GENERATION (dream-machine, ray-1)
LUMAAI_API_KEY=your_luma_api_key

# Database
DATABASE_URL=postgresql://postgres:pass@db.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
