# ==========================================
# OmniBridge API Gateway & Orchestration Env
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
WS_PORT=5001
GATEWAY_SECRET=your_super_secret_gateway_key_here
CORS_ORIGIN=http://localhost:3000

# AI Provider API Keys
# ------------------------------------------
# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Together AI API
TOGETHER_API_KEY=your_together_ai_api_key_here

# Luma AI API (Dream Machine Video Generation)
LUMAAI_API_KEY=your_luma_api_key_here

# Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend Configuration (Next.js Public Envs)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:5001
